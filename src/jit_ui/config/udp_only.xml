<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for led_driver_node ONLY: UDPv4, no shared memory.

  led_driver_node runs as root (rpi_ws281x needs it) while every other node
  runs as the login user. Fast DDS's shared-memory transport cannot carry data
  across that boundary - the nodes discover each other but no samples arrive,
  so the panel never left its boot RED. Confirmed on the bench: with this
  profile the root node receives led/command from a user publisher.

  Loaded via FASTRTPS_DEFAULT_PROFILES_FILE, set by jit_bringup.launch.py for
  the root-run LED node alone. Every other node keeps shared memory.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_only</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
